import cv2
import numpy as np
import pygame
import serial
import time
import math

# --- Configuration ---
SERIAL_PORT = "COM9"  # Double-check this against your Arduino IDE!
BAUD_RATE = 115200
CAMERA_INDEX = 0      # Assigned to your working USB camera index

try:
    esp32 = serial.Serial(SERIAL_PORT, BAUD_RATE, timeout=0.01, write_timeout=0.01)
    time.sleep(2)
    print(f"Connected to ESP32 on {SERIAL_PORT}")
except Exception as e:
    print(f"Error connecting to {SERIAL_PORT}: {e}")
    exit()

pygame.init()
pygame.joystick.init()

if pygame.joystick.get_count() == 0:
    print("No controller found!")
    exit()

joystick = pygame.joystick.Joystick(0)
joystick.init()

cap = cv2.VideoCapture(CAMERA_INDEX)
cap.set(cv2.CAP_PROP_FOURCC, cv2.VideoWriter_fourcc(*'MJPG'))
cap.set(cv2.CAP_PROP_FPS, 60)
cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)

# Track system angles
pan_angle = 90.0
tilt_angle = 90.0

# Mechanical limits
MIN_PAN, MAX_PAN = 0, 180
MIN_TILT, MAX_TILT = 30, 150  

# Tuning Variables (LOCKED AS REQUESTED)
DEADZONE = 0.5          
L_MIN_STEP, L_MAX_STEP = 1.5, 16.0          
R_MAX_STEP = 4.0          
DPAD_STEP = 1.0          

# --- AUTOMATED ADAPTIVE TRACKING CONFIGURATION ---
SCREEN_CENTER_X = 320    
SCREEN_CENTER_Y = 240    

# LOCKED AS REQUESTED: Absolute quiet zone buffer
TRACK_DEADZONE = 60      

# --- ADAPTIVE DUAL-STAGE SPEEDS ---
# Close to the center, it glides at a buttery 0.8 speed.
# Far away, it snaps hard at a fast 3.5 speed.
MIN_AUTO_SPEED = 0.8
MAX_AUTO_SPEED = 3.5
ADAPTIVE_SCALING = 0.02  # Controls how quickly it transitions from buttery to snappy

# Override tracker timing
last_manual_input_time = 0
AUTO_TRACK_DELAY = 1.0   

# --- SENTRY MODE CONFIGURATION ---
SENTRY_DELAY = 4.0        
SENTRY_SPEED = 0.5        
SENTRY_MIN_PAN = 40       
SENTRY_MAX_PAN = 140      
sentry_direction = 1      
last_target_seen_time = time.time()

last_sent_pan = 90
last_sent_tilt = 90

print("\n--- ADAPTIVE DUAL-STAGE (SNAP/BUTTER) NEON-GREEN TRACKING ACTIVE ---")

try:
    while True:
        ret, frame = cap.read()
        if not ret: break

        # Vision tracking pipeline
        blurred = cv2.GaussianBlur(frame, (5, 5), 0)
        hsv = cv2.cvtColor(blurred, cv2.COLOR_BGR2HSV)

        # Neon Green HSV Mask
        lower_green = np.array([35, 100, 100])
        upper_green = np.array([85, 255, 255])
        mask_green = cv2.inRange(hsv, lower_green, upper_green)
        mask_green = cv2.dilate(cv2.erode(mask_green, None), None)

        # Find largest green target coordinate
        target_found = False
        target_x, target_y = 0, 0
        largest_area = 0

        contours_g, _ = cv2.findContours(mask_green, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        for c in contours_g:
            area = cv2.contourArea(c)
            if area > 300: 
                if area > largest_area:
                    largest_area = area
                    x, y, w, h = cv2.boundingRect(c)
                    target_x = x + (w // 2) 
                    target_y = y + (h // 2) 
                    target_found = True
                    
                    cv2.rectangle(frame, (x, y), (x+w, y+h), (0, 255, 0), 2)
                    cv2.circle(frame, (target_x, target_y), 5, (0, 0, 255), -1)
                    cv2.putText(frame, "LOCKED TARGET", (x, y - 10), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 0), 2)

        # Draw your custom 60px deadzone visual safety circle
        cv2.circle(frame, (SCREEN_CENTER_X, SCREEN_CENTER_Y), TRACK_DEADZONE, (255, 255, 255), 1)
        cv2.line(frame, (SCREEN_CENTER_X - 15, SCREEN_CENTER_Y), (SCREEN_CENTER_X + 15, SCREEN_CENTER_Y), (255, 255, 255), 1)
        cv2.line(frame, (SCREEN_CENTER_X, SCREEN_CENTER_Y - 15), (SCREEN_CENTER_X, SCREEN_CENTER_Y + 15), (255, 255, 255), 1)

        # Read Controller Inputs
        pygame.event.pump()
        current_time = time.time()

        l_joy_x = joystick.get_axis(0)
        l_joy_y = joystick.get_axis(1)
        r_joy_x = joystick.get_axis(2)
        r_joy_y = joystick.get_axis(3)
        dpad_x, dpad_y = joystick.get_hat(0)

        is_manual = (abs(l_joy_x) > DEADZONE or abs(l_joy_y) > DEADZONE or 
                     abs(r_joy_x) > DEADZONE or abs(r_joy_y) > DEADZONE or 
                     dpad_x != 0 or dpad_y != 0 or joystick.get_button(2))

        if is_manual:
            last_manual_input_time = current_time 

        if target_found:
            last_target_seen_time = current_time

        # --- CONTROLLER MANUALLY OVERRIDES SYSTEM ---
        if is_manual:
            if joystick.get_button(2): 
                pan_angle = 90.0
                tilt_angle = 90.0
            else:
                if abs(l_joy_x) > DEADZONE:
                    deflection_x = (abs(l_joy_x) - DEADZONE) / (1.0 - DEADZONE)
                    pan_angle += (L_MIN_STEP + ((deflection_x ** 2) * (L_MAX_STEP - L_MIN_STEP))) if l_joy_x > 0 else -(L_MIN_STEP + ((deflection_x ** 2) * (L_MAX_STEP - L_MIN_STEP)))
                elif abs(r_joy_x) > DEADZONE:
                    pan_angle += (r_joy_x * R_MAX_STEP)
                elif dpad_x != 0:
                    pan_angle += dpad_x * DPAD_STEP

                if abs(l_joy_y) > DEADZONE:
                    deflection_y = (abs(l_joy_y) - DEADZONE) / (1.0 - DEADZONE)
                    tilt_angle += (L_MIN_STEP + ((deflection_y ** 2) * (L_MAX_STEP - L_MIN_STEP))) if l_joy_y > 0 else -(L_MIN_STEP + ((deflection_y ** 2) * (L_MAX_STEP - L_MIN_STEP)))
                elif abs(r_joy_y) > DEADZONE:
                    tilt_angle += (r_joy_y * R_MAX_STEP)
                elif dpad_y != 0:
                    if dpad_y > 0: tilt_angle -= DPAD_STEP
                    else: tilt_angle += DPAD_STEP

        # --- AUTONOMOUS DUAL-STAGE TRACKING LOOPS ---
        elif target_found and (current_time - last_manual_input_time > AUTO_TRACK_DELAY):
            
            # Pan tracking
            error_x = target_x - SCREEN_CENTER_X
            if abs(error_x) > TRACK_DEADZONE:
                # The magic sauce: distance beyond the deadzone triggers exponential speed scaling
                distance_past_deadzone_x = abs(error_x) - TRACK_DEADZONE
                calculated_speed_x = min(MAX_AUTO_SPEED, MIN_AUTO_SPEED + (distance_past_deadzone_x * ADAPTIVE_SCALING))
                
                # Display state for tuning feedback
                state_str = "SNAP" if calculated_speed_x > 2.0 else "BUTTER"
                cv2.putText(frame, f"PAN: {state_str} ({calculated_speed_x:.1f})", (20, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 0), 2)

                if error_x > 0:
                    pan_angle -= calculated_speed_x
                else:
                    pan_angle += calculated_speed_x

            # Tilt tracking
            error_y = target_y - SCREEN_CENTER_Y
            if abs(error_y) > TRACK_DEADZONE:
                distance_past_deadzone_y = abs(error_y) - TRACK_DEADZONE
                calculated_speed_y = min(MAX_AUTO_SPEED, MIN_AUTO_SPEED + (distance_past_deadzone_y * ADAPTIVE_SCALING))
                
                if error_y > 0:
                    tilt_angle += calculated_speed_y
                else:
                    tilt_angle -= calculated_speed_y

        # --- SENTRY MODE ---
        elif (current_time - last_target_seen_time > SENTRY_DELAY) and (current_time - last_manual_input_time > AUTO_TRACK_DELAY):
            cv2.putText(frame, "SENTRY MODE ACTIVE", (20, 40), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 0), 2)
            
            if abs(tilt_angle - 90.0) > 1.0:
                tilt_angle += 0.5 if tilt_angle < 90.0 else -0.5
            
            pan_angle += sentry_direction * SENTRY_SPEED
            if pan_angle >= SENTRY_MAX_PAN:
                pan_angle = SENTRY_MAX_PAN
                sentry_direction = -1
            elif pan_angle <= SENTRY_MIN_PAN:
                pan_angle = SENTRY_MIN_PAN
                sentry_direction = 1

        # Apply Safety Boundaries
        pan_angle = max(MIN_PAN, min(pan_angle, MAX_PAN))
        tilt_angle = max(MIN_TILT, min(tilt_angle, MAX_TILT))

        # Pack and send serial data
        current_pan = int(pan_angle)
        current_tilt = int(tilt_angle)

        if current_pan != last_sent_pan or current_tilt != last_sent_tilt:
            try:
                command = f"{current_pan},{current_tilt}\n"
                esp32.write(command.encode('utf-8'))
                last_sent_pan = current_pan
                last_sent_tilt = current_tilt
            except serial.SerialTimeoutException:
                pass

        cv2.imshow("High-Speed Tracking Station", frame)
        if cv2.waitKey(1) & 0xFF == ord('q'): break

except KeyboardInterrupt:
    print("\nShutting down station...")
finally:
    cap.release()
    cv2.destroyAllWindows()
    esp32.close()
    pygame.quit()

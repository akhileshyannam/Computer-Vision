    </html>
    """)

def generate_frames():
    global output_frame, frame_lock
    while True:
        with frame_lock:
            if output_frame is None:
                continue
            ret, buffer = cv2.imencode('.jpg', output_frame)
            if not ret:
                continue
            frame_bytes = buffer.tobytes()
        
        yield (b'--frame\r\n'
               b'Content-Type: image/jpeg\r\n\r\n' + frame_bytes + b'\r\n')
        time.sleep(1/60)

@app.route('/video_feed')
def video_feed():
    return Response(generate_frames(), mimetype='multipart/x-mixed-replace; boundary=frame')

@app.route('/set_mode')
def set_mode():
    global system_mode
    mode = request.args.get('mode', 'auto')
    if mode in ['auto', 'manual']:
        system_mode = mode
    return jsonify({"mode": system_mode})

@app.route('/manual_move')
def manual_move():
    global pan_angle, tilt_angle, system_mode
    if system_mode != 'manual':
        return jsonify({"status": "ignored_in_auto_mode"})
    
    direction = request.args.get('dir', '')
    if direction == 'up':
        tilt_angle -= DPAD_STEP
    elif direction == 'down':
        tilt_angle += DPAD_STEP
    elif direction == 'left':
        pan_angle += DPAD_STEP
    elif direction == 'right':
        pan_angle -= DPAD_STEP

    return jsonify({"pan": int(pan_angle), "tilt": int(tilt_angle)})

if __name__ == '__main__':
    # Initialize the high-speed background tracking system thread
    t = threading.Thread(target=vision_and_control_loop)
    t.daemon = True
    t.start()
    
    # Launch Flask on port 5000, listening on all local interfaces
    app.run(host='0.0.0.0', port=5000, debug=False, threaded=True)

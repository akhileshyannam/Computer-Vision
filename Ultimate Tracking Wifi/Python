    </head>
    <body>
        <div class="container">
            <h2>Hybrid Networked Sentry Station</h2>
            <img src="/video_feed">
            
            <div class="controls">
                <button id="modeAuto" class="btn active" onclick="setMode('auto')">Auto Track Mode</button>
                <button id="modeManual" class="btn" onclick="setMode('manual')">Manual Control</button>
            </div>

            <div class="dpad">
                <div class="empty"></div>
                <div class="dbtn" id="pad_up">▲</div>
                <div class="empty"></div>
                <div class="dbtn" id="pad_left">◀</div>
                <div class="empty"></div>
                <div class="dbtn" id="pad_right">▶</div>
                <div class="empty"></div>
                <div class="dbtn" id="pad_down">▼</div>
                <div class="empty"></div>
            </div>
        </div>

        <script>
            let activeDirection = null;
            let tickInterval = null;

            function setMode(mode) {
                fetch('/set_mode?mode=' + mode)
                .then(r => r.json())
                .then(data => {
                    document.getElementById('modeAuto').className = 'btn ' + (data.mode === 'auto' ? 'active' : '');
                    document.getElementById('modeManual').className = 'btn ' + (data.mode === 'manual' ? 'active' : '');
                });
            }

            function sendManualTick() {
                if (!activeDirection) return;
                fetch('/manual_move?dir=' + activeDirection);
            }

            function setupDpadButton(id, direction) {
                const btn = document.getElementById(id);
                
                const startEvent = (e) => {
                    e.preventDefault();
                    activeDirection = direction;
                    if(!tickInterval) {
                        sendManualTick(); // Send instant response
                        tickInterval = setInterval(sendManualTick, 50); // Fluid 50ms loop interval ticks
                    }
                };

                const endEvent = (e) => {
                    e.preventDefault();
                    activeDirection = null;
                    clearInterval(tickInterval);
                    tickInterval = null;
                };

                btn.addEventListener('touchstart', startEvent);
                btn.addEventListener('touchend', endEvent);
                btn.addEventListener('mousedown', startEvent);
                btn.addEventListener('mouseup', endEvent);
                btn.addEventListener('mouseleave', endEvent);
            }

            setupDpadButton('pad_up', 'up');
            setupDpadButton('pad_down', 'down');
            setupDpadButton('pad_left', 'left');
            setupDpadButton('pad_right', 'right');
        </script>
